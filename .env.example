# Picnic Expense Tracker — Environment Variables Template
# Copy this to .env and fill in your actual values (NEVER commit .env to git!)

# ==== IMAP Configuration (Uberspace Mailbox) ====
IMAP_HOST=localhost
IMAP_PORT=993
IMAP_USERNAME=your-username@example.com
IMAP_PASSWORD=your-app-password-or-passwort
IMAP_MAILBOX=INBOX
IMAP_USE_SSL=true
# Only emails whose subject contains this string are ingested
IMAP_SUBJECT_FILTER=Dein Bon

# ==== Database ====
DATABASE_URL=sqlite:///./picnic.db
# For Uberspace persistence, use: sqlite:////home/user/data/picnic.db

# ==== FastAPI ====
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# ==== Email Polling Schedule (seconds) ====
POLLING_INTERVAL=1800  # 30 minutes

# ==== CORS (Frontend URL) ====
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ==== Statistics ====
# Monthly grocery budget in cents, used by GET /api/stats/budget
MONTHLY_BUDGET_CENTS=0

# ==== Optional: Logging ====
# LOG_FILE=/var/log/picnic/backend.log

# ==== URL scheme (REQ-019) ====
# Path every backend route is mounted under. Leave unset for the default
# path-based scheme (/picnic/*, /picnic-frontend/), matching Uberspace's
# path routing. A host with its own domain (no shared path routing) sets
# URL_PREFIX= (empty) to serve from its domain root instead.
# URL_PREFIX=
#
# Frontend build-time equivalents, read by scripts/deploy.sh and passed to
# `npm run build`. Leave unset for the default dev/staging values shown
# below; a domain-root host sets VITE_BASE_PATH=/ and VITE_API_BASE=/api.
# VITE_BASE_PATH=/picnic-frontend/
# VITE_API_BASE=/picnic/api
#
# Where scripts/deploy.sh publishes the built frontend. Leave unset for the
# default (~/html/picnic-frontend); a domain-root host points this at that
# domain's own document root, e.g.
# FRONTEND_PUBLISH_DIR=/var/www/virtual/<user>/<domain>
# FRONTEND_PUBLISH_DIR=
